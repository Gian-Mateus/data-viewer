{
    "name": "@manadah/data-viewer",
    "version": "0.1.0",
    "description": "DataViewer para Vue 3 + Vue/Inertia: tabela e grid com filtros, ordenação, seleção e paginação.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "files": [
        "src",
        "README.md"
    ],
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        },
        "./inertia": {
            "types": "./src/inertia.ts",
            "import": "./src/inertia.ts"
        },
        "./src/*": "./src/*",
        "./package.json": "./package.json"
    },
    "keywords": [
        "vue",
        "inertia",
        "laravel",
        "table",
        "dataviewer",
        "shadcn-vue"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/manadah/data-viewer.git",
        "directory": "packages/vue"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@lucide/vue": "^1.63.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.2.0"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "@vueuse/core": "^12.8.2",
        "reka-ui": "^2.11.0",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-sonner": "^2.0.0"
    },
    "peerDependenciesMeta": {
        "@inertiajs/vue3": {
            "optional": true
        },
        "tw-animate-css": {
            "optional": true
        }
    }
}
