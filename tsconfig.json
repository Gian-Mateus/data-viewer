{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "jsx": "preserve",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["vite/client", "vitest/globals"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["dev/*"]
        }
    },
    "include": [
        "packages/laravel/resources/js/data-viewer/**/*.ts",
        "packages/laravel/resources/js/data-viewer/**/*.vue",
        "packages/laravel/tests/vue/**/*.ts",
        "dev/**/*.ts",
        "dev/**/*.vue"
    ]
}
